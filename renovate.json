{
  "assignees": [
    "team:portal-dev"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "branchPrefix": "deps/",
  "bumpVersion": "minor",
  "commitBodyTable": true,
  "commitMessagePrefix": "feat(Dependencies):",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],
  "ignore": [
    {
      "updateTypes": [
        "digest"
      ]
    }
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "addLabels": [
        "major"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "addLabels": [
        "minor"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "addLabels": [
        "patch"
      ],
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "addLabels": [
        "pin"
      ],
      "matchUpdateTypes": [
        "pin"
      ]
    },
    {
      "matchLabels": [
        "security"
      ],
      "minimumReleaseAge": null
    }
  ],
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "reviewers": [
    "team:portal-dev"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "minimumReleaseAge": "3 days"
}